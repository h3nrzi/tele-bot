{
	"name": "tele-bot",
	"version": "0.1.0",
	"description": "Telegram-native marketplace bot with double-entry ledger and wallet top-ups",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc",
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"dev": "tsx watch src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:clean": "tsx src/scripts/clean.ts",
		"db:destroy": "tsx src/scripts/clean.ts",
		"db:seed": "tsx src/scripts/seed.ts",
		"db:reset": "tsx src/scripts/reset.ts"
	},
	"dependencies": {
		"@grammyjs/conversations": "^2.1.1",
		"decimal.js": "^10.4.3",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.30.2",
		"drizzle-orm": "^0.38.4",
		"grammy": "^1.34.0",
		"pg": "^8.13.1",
		"reflect-metadata": "^0.2.2",
		"tsx": "^4.19.2",
		"tsyringe": "^4.10.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.7",
		"@types/pg": "^8.11.11",
		"prettier": "^3.9.8",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	},
	"engines": {
		"node": ">=22.13.0",
		"npm": ">=10.0.0"
	},
	"packageManager": "npm@10.0.0"
}
